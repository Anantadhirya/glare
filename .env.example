# Global Configuration
DEBUG=false
DEBUG_TIME=false

# MQTT Configuration
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_SUBSCRIBE_TOPIC=esp32/cam_0
MQTT_PUBLISH_BASE64_TOPIC=glare/cam_1
MQTT_PUBLISH_SHORT_RESULT_TOPIC=glare/result
MQTT_PUBLISH_COMPLETE_RESULT_TOPIC=glare/complete_result

# Face Recognition Configuration
KNOWN_FACES_DIR=known_faces
RECOGNITION_THRESHOLD=0.7
TOP_K_RESULTS=5

STORE_THRESHOLD=0.85
MIN_FACE_SIZE=50,50

CLEAR_DELAY=5.0

# Database Configuration
DATABASE_URL=your_database_url_here

# CDN Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret